{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Cycle log object (contract 5.3)",
  "type": "object",
  "required": ["cycle_index", "start_date", "cycle_length_days", "flow", "pain", "symptoms"],
  "additionalProperties": false,
  "properties": {
    "cycle_index": {"type": "integer", "minimum": 1},
    "start_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "cycle_length_days": {"type": "integer", "minimum": 10, "maximum": 120},
    "flow": {"type": "integer", "minimum": 0, "maximum": 3},
    "pain": {"type": "integer", "minimum": 0, "maximum": 10},
    "symptoms": {
      "type": "object",
      "required": ["acne", "excess_hair", "hair_loss", "fatigue", "mood", "weight_change", "dizziness", "pallor"],
      "additionalProperties": false,
      "properties": {
        "acne": {"type": "integer", "minimum": 0, "maximum": 3},
        "excess_hair": {"type": "integer", "minimum": 0, "maximum": 3},
        "hair_loss": {"type": "integer", "minimum": 0, "maximum": 3},
        "fatigue": {"type": "integer", "minimum": 0, "maximum": 3},
        "mood": {"type": "integer", "minimum": 0, "maximum": 3},
        "weight_change": {"type": "integer", "minimum": 0, "maximum": 3},
        "dizziness": {"type": "integer", "minimum": 0, "maximum": 3},
        "pallor": {"type": "integer", "minimum": 0, "maximum": 3}
      }
    }
  }
}
